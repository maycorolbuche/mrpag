<%- include('header', {title:editing?'Editar cliente':'Novo cliente'}) %>
<a class="back-link" href="<%= editing?'/customers/'+customer.id:'/customers' %>">← <%= editing?'Voltar ao cliente':'Todos os clientes' %></a><span class="overline">CLIENTES</span><h1 class="workspace-title"><%= editing?'Editar cliente':'Um novo relacionamento.' %></h1><p class="text-secondary">Preencha os dados do cliente. Os campos com * são obrigatórios.</p>
<% if(Object.keys(errors).length) { %><div class="alert alert-danger" role="alert">Confira os campos destacados antes de salvar.</div><% } %>
<form action="<%= editing?'/customers/'+customer.id+'/update':'/customers' %>" method="post" class="settings-card customer-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
<h2>Identificação</h2><div class="row g-4"><div class="col-md-4"><label for="person_type" class="form-label">Tipo de pessoa *</label><select id="person_type" name="person_type" class="form-select <%= errors.person_type?'is-invalid':'' %>" required><option value="person" <%= customer.person_type==='person'?'selected':'' %>>Pessoa física</option><option value="company" <%= customer.person_type==='company'?'selected':'' %>>Pessoa jurídica</option></select><% if(errors.person_type) { %><div class="invalid-feedback"><%= errors.person_type %></div><% } %></div>
<% const fields=[['name','Nome / razão social *',150,'text','col-md-8'],['trade_name','Nome fantasia',150,'text','col-md-6'],['document','CPF / CNPJ',18,'text','col-md-6'],['email','E-mail',254,'email','col-md-6'],['phone','Telefone / WhatsApp',25,'tel','col-md-6']]; for(const [field,label,max,type,classes] of fields) { %>
<div class="<%= classes %>"><label for="<%= field %>" class="form-label"><%= label %></label><input id="<%= field %>" name="<%= field %>" type="<%= type %>" class="form-control <%= errors[field]?'is-invalid':'' %>" value="<%= customer[field] || '' %>" maxlength="<%= max %>" <%- field==='name'?'required minlength="2"':'' %> <%- ['document','phone'].includes(field)?'inputmode="tel"':'' %> aria-invalid="<%= errors[field]?'true':'false' %>" aria-describedby="<%= field %>-error"><% if(errors[field]) { %><div class="invalid-feedback" id="<%= field %>-error"><%= errors[field] %></div><% } %></div><% } %></div>
<p class="field-note">CPF/CNPJ e contato são opcionais nesta etapa. Documentos informados são validados e não podem se repetir na mesma conta.</p>
<hr><h2>Endereço</h2><div class="row g-4"><% const address=[['postal_code','CEP',9,'col-md-3'],['street','Logradouro',150,'col-md-7'],['number','Número',20,'col-md-2'],['complement','Complemento',100,'col-md-6'],['neighborhood','Bairro',100,'col-md-6'],['city','Cidade',100,'col-md-9']]; for(const [field,label,max,classes] of address) { %><div class="<%= classes %>"><label for="<%= field %>" class="form-label"><%= label %></label><input id="<%= field %>" name="<%= field %>" class="form-control <%= errors[field]?'is-invalid':'' %>" value="<%= customer[field] || '' %>" maxlength="<%= max %>" aria-invalid="<%= errors[field]?'true':'false' %>"><% if(errors[field]) { %><div class="invalid-feedback"><%= errors[field] %></div><% } %></div><% } %><div class="col-md-3"><label for="state" class="form-label">UF</label><select id="state" name="state" class="form-select <%= errors.state?'is-invalid':'' %>"><option value="">Selecione</option><% for(const uf of 'AC AL AP AM BA CE DF ES GO MA MT MS MG PA PB PR PE PI RJ RN RS RO RR SC SP SE TO'.split(' ')) { %><option value="<%= uf %>" <%= customer.state===uf?'selected':'' %>><%= uf %></option><% } %></select><% if(errors.state) { %><div class="invalid-feedback"><%= errors.state %></div><% } %></div></div>
<hr><h2>Organização</h2><div class="row g-4"><div class="col-md-4"><label for="active" class="form-label">Situação *</label><select id="active" name="active" class="form-select" required><option value="1" <%= customer.active?'selected':'' %>>Ativo</option><option value="0" <%= !customer.active?'selected':'' %>>Inativo</option></select><% if(errors.active) { %><p class="text-danger"><%= errors.active %></p><% } %></div><div class="col-md-8"><label for="notes" class="form-label">Observações</label><textarea class="form-control <%= errors.notes?'is-invalid':'' %>" id="notes" name="notes" rows="3" maxlength="2000"><%= customer.notes %></textarea><% if(errors.notes) { %><div class="invalid-feedback"><%= errors.notes %></div><% } %></div></div><div class="form-actions"><a class="btn btn-light" href="<%= editing?'/customers/'+customer.id:'/customers' %>">Cancelar</a><button type="submit" class="btn btn-primary">Salvar cliente →</button></div></form></main></body></html>
