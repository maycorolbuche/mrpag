<%- include('header', {title:'Clientes'}) %>
<div class="page-heading"><div><span class="overline">RELACIONAMENTOS</span><h1 class="workspace-title">Seus clientes.</h1><p class="text-secondary">Organize os contatos que farão parte das suas cobranças.</p></div><a class="btn btn-primary" href="/customers/new">+ Novo cliente</a></div>
<section class="settings-card customers-card"><form class="customer-filters" method="get" action="/customers"><div><label for="q" class="form-label">Buscar cliente</label><input id="q" class="form-control" type="search" name="q" value="<%= filters.q %>" maxlength="150" placeholder="Nome, e-mail, CPF/CNPJ ou telefone"></div><div><label for="status" class="form-label">Situação</label><select id="status" name="status" class="form-select"><option value="">Todas</option value="1" <%= filters.status==='1'?'selected':'' %>>Ativos</option><option value="0" <%= filters.status==='0'?'selected':'' %>>Inativos</option></select></div><button class="btn btn-primary" type="submit">Filtrar</button><a href="/customers" class="btn btn-light">Limpar</a></form>
<div class="list-summary"><strong><%= pagination.total %></strong> cliente<%= pagination.total===1?'':'s' %> encontrado<%= pagination.total===1?'':'s' %></div>
<% if(!customers.length) { %><div class="empty-state"><div class="page-icon">◎</div><h2><%= filters.q || filters.status ? 'Nenhum cliente encontrado.' : 'Sua lista começa por aqui.' %></h2><p class="text-secondary"><%= filters.q || filters.status ? 'Ajuste os filtros para buscar outros resultados.' : 'Cadastre o primeiro cliente para organizar seus contatos.' %></p><a href="/customers/new" class="btn btn-primary">Cadastrar cliente</a></div><% } else { %>
<div class="table-responsive"><table class="table customers-table"><caption class="visually-hidden">Clientes da sua conta</caption><thead><tr><th scope="col">Cliente</th><th scope="col">CPF/CNPJ</th><th scope="col">Contato</th><th scope="col">Situação</th><th scope="col"><span class="visually-hidden">Ações</span></th></tr></thead><tbody>
<% for(const item of customers) { %><tr><td><a class="customer-name" href="/customers/<%= item.id %>"><%= item.name %></a><small><%= item.person_type==='person'?'Pessoa física':'Pessoa jurídica' %></small></td><td><%= item.document || '—' %></td><td><span><%= item.email || '—' %></span><small><%= item.phone || '' %></small></td><td><span class="status-pill <%= item.active?'':'inactive' %>"><%= item.active?'Ativo':'Inativo' %></span></td><td><a href="/customers/<%= item.id %>/edit" aria-label="Editar <%= item.name %>">Editar ↗</a></td></tr><% } %>
</tbody></table></div>
<% if(pagination.pages>1) { const link=(page)=>'/customers?'+new URLSearchParams({q:filters.q,status:filters.status,page:String(page)}).toString(); %><nav class="list-pagination" aria-label="Paginação de clientes"><span>Página <%= pagination.page %> de <%= pagination.pages %></span><div><% if(pagination.page>1) { %><a class="btn btn-light" href="<%= link(pagination.page-1) %>">← Anterior</a><% } %><% if(pagination.page<pagination.pages) { %><a class="btn btn-light" href="<%= link(pagination.page+1) %>">Próxima →</a><% } %></div></nav><% } %><% } %></section></main></body></html>
