<%- include('header', {title:'Detalhes da cobrança'}) %>
<a class="back-link" href="/charges">← Cobranças</a>
<h1 class="workspace-title text-break"><%= charge.description %></h1>
<% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
<div class="settings-grid">
  <section class="settings-card">
    <dl class="customer-data">
      <div><dt>Cliente</dt><dd><%= charge.customer_name %></dd></div>
      <div><dt>Valor</dt><dd><%= charge.amount %></dd></div>
      <div><dt>Vencimento</dt><dd><%= charge.date %></dd></div>
      <div><dt>Situação</dt><dd><strong><%= charge.label %></strong></dd></div>
      <% if (charge.recurring_series_id) { %><div><dt>Recorrência</dt><dd><a href="/charges/recurring/<%= charge.recurring_series_id %>">Ver série</a></dd></div><% } %>
      <% if (charge.paid_at) { %>
        <div><dt>Pago em</dt><dd><%= new Date(charge.paid_at).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></dd></div>
      <% } %>
      <% if (charge.provider_id) { %>
        <div><dt>Pagamento no Mercado Pago</dt><dd><%= charge.provider_id %></dd></div>
      <% } %>
    </dl>
    <% if (charge.provider_id || charge.canRetry) { %>
      <form method="post" action="/charges/<%= charge.id %>/<%= charge.provider_id ? 'refresh' : 'retry' %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-light" type="submit"><%= charge.provider_id ? 'Consultar situação' : 'Tentar emitir novamente' %></button>
      </form>
    <% } else { %>
      <p>Confira no painel do Mercado Pago se a emissão foi concluída antes de criar outra cobrança.</p>
    <% } %>
    <% if (charge.canCancel) { %>
      <details class="mt-3">
        <summary>Cancelar cobrança</summary>
        <form method="post" action="/charges/<%= charge.id %>/cancel" class="mt-2">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <p>O MR Pag vai solicitar o cancelamento ao Mercado Pago. Depois da confirmação, o Pix deixa de aparecer no link de pagamento.</p>
          <button class="btn btn-outline-danger" type="submit">Confirmar cancelamento</button>
        </form>
      </details>
    <% } %>
  </section>
  <%- include('charge-pix') %>
</div>
<% if (publicUrl) { %><%- include('charge-email-history') %><% } %>
</main></body></html>
