<section class="settings-card mb-4" id="recorrentes" aria-labelledby="recurring-title">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0" id="recurring-title">Cobranças Recorrentes</h2>
    <a class="btn btn-primary" href="/charges/recurring/new">Nova Cobrança Recorrente</a>
  </div>
  <% if (!seriesRows.length) { %><p class="mb-0">Nenhuma recorrência nesta página.</p><% } else { %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th>Descrição</th><th>Cliente</th><th>Valor</th><th>Frequência</th><th>Próximo vencimento</th><th>Situação</th></tr></thead>
        <tbody>
          <% for (const item of seriesRows) { %>
            <tr><td><a href="/charges/recurring/<%= item.id %>"><%= item.description %></a></td><td><%= item.customer_name %></td><td><%= item.amount %></td><td><%= item.frequency %></td><td><%= item.status === 'ended' ? '—' : item.due %></td><td><%= item.state %><% if (item.emission_review) { %><br><span class="text-danger">Emissão a conferir</span><% } %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
  <% if (recurringPage > 1 || nextRecurringPage) { %>
    <nav class="d-flex gap-2" aria-label="Paginação de cobranças recorrentes">
      <% if (recurringPage > 1) { %><a class="btn btn-light" href="/charges?page=<%= chargePage %>&amp;recurringPage=<%= recurringPage - 1 %>#recorrentes">Anterior</a><% } %>
      <% if (nextRecurringPage) { %><a class="btn btn-light" href="/charges?page=<%= chargePage %>&amp;recurringPage=<%= recurringPage + 1 %>#recorrentes">Próxima</a><% } %>
    </nav>
  <% } %>
</section>
