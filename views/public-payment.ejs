<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Cobrança · MR Pag</title>
  <link rel="icon" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/bootstrap/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/app.css">
  <link rel="stylesheet" href="/assets/payment.css">
  <% if (charge?.status === 'pending') { %><script src="/assets/payment-status.js" defer></script><% } %>
</head>
<body class="payment-page">
<header class="payment-brand">
  <img src="/assets/favicon.svg" width="36" height="36" alt="">
  <span>MR <strong>Pag</strong></span>
</header>
<main class="payment-main">
  <% if (charge) { %>
    <% const hasPix = charge.status === 'pending' && (charge.pix_image || charge.pix_code); %>
    <% const amountTitles = { pending: 'Valor a pagar', paid: 'Valor pago' }; %>
    <div class="payment-layout<%= hasPix ? ' payment-layout--pix' : '' %>">
      <section class="payment-summary" aria-labelledby="payment-title">
        <div class="payment-summary__hero">
          <h1 id="payment-title"><%= amountTitles[charge.status] ?? 'Valor da cobrança' %></h1>
          <p class="payment-amount"><%= charge.amount %></p>
          <p class="payment-status payment-status--<%= charge.status %>">
            <span class="visually-hidden">Situação: </span><span class="payment-status__dot" aria-hidden="true"></span><strong><%= charge.label %></strong>
          </p>
        </div>
        <div class="payment-summary__details">
          <dl class="payment-details">
            <div class="payment-details__description"><dt>Descrição</dt><dd><%= charge.description %></dd></div>
            <div><dt>Recebedor</dt><dd><%= charge.issuer %></dd></div>
            <div><dt>Vencimento</dt><dd><%= charge.date %></dd></div>
          </dl>
          <% if (charge.status === 'pending') { %>
            <div class="payment-update">
              <p>A situação é atualizada automaticamente após a confirmação do pagamento.</p>
              <a href="">Atualizar situação</a>
            </div>
          <% } %>
        </div>
      </section>
      <%- include('charge-pix') %>
    </div>
  <% } else { %>
    <section class="payment-empty">
      <h1>Cobrança não encontrada</h1>
      <p>Confira o link recebido.</p>
    </section>
  <% } %>
</main>
</body>
</html>
