<%- include('header', {title:'E-mails de cobrança'}) %>
<a class="back-link" href="/account">← Minha conta</a>
<h1 class="workspace-title">E-mails de cobrança</h1>
<section class="settings-card">
  <% if (saved) { %><p class="alert alert-success" role="status">Preferências salvas.</p><% } %>
  <% if (success) { %><p class="alert alert-success" role="status"><%= success %></p><% } %>
  <% if (error) { %><p class="alert alert-danger" role="alert"><%= error %></p><% } %>
  <p class="text-secondary">Os testes usam dados fictícios e são enviados para <strong class="text-break"><%= user.email %></strong>.</p>
  <form method="post" action="/account/notifications">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <fieldset class="mb-4">
      <legend>Cobrança inicial</legend>
      <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <span>E-mail de criação da cobrança Pix</span>
        <button class="btn btn-light btn-sm" type="submit" formaction="/account/notifications?preview=charge"
          aria-label="Enviar teste de cobrança inicial">Enviar teste</button>
      </div>
    </fieldset>
    <fieldset class="mb-4">
      <legend>Lembretes de vencimento</legend>
      <p class="text-secondary">Cobranças automáticas e lembretes são enviados das 8h até antes das 10h, no horário de Brasília.</p>
      <% for (const [key, label] of [
        ['before_due', 'Três dias antes do vencimento'],
        ['due_today', 'No dia do vencimento'],
        ['overdue', 'Três dias após o vencimento'],
      ]) { %>
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-2">
          <label class="form-check mb-0">
            <input type="checkbox" class="form-check-input" name="<%= key %>" <%= notifications[key] ? 'checked' : '' %>>
            <span class="form-check-label"><%= label %></span>
          </label>
          <button class="btn btn-light btn-sm" type="submit" formaction="/account/notifications?preview=<%= key %>"
            aria-label="Enviar teste: <%= label %>">Enviar teste</button>
        </div>
      <% } %>
    </fieldset>
    <fieldset class="mb-4">
      <legend>Confirmação de pagamento</legend>
      <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <label class="form-check mb-0">
          <input type="checkbox" class="form-check-input" name="confirmation" <%= notifications.confirmation ? 'checked' : '' %>>
          <span class="form-check-label">Enviar e-mail quando o pagamento for confirmado</span>
        </label>
        <button class="btn btn-light btn-sm" type="submit" formaction="/account/notifications?preview=confirmation"
          aria-label="Enviar teste de confirmação de pagamento">Enviar teste</button>
      </div>
    </fieldset>
    <button class="btn btn-primary" type="submit">Salvar preferências</button>
  </form>
</section>
</main></body></html>
