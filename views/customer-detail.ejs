<%- include('header', {title:customer.name}) %><a class="back-link" href="/customers">← Todos os clientes</a>
<div class="page-heading"><div><span class="overline">CLIENTE</span><h1 class="workspace-title"><%= customer.name %></h1><p class="text-secondary"><%= customer.person_type==='person'?'Pessoa física':'Pessoa jurídica' %> <span class="status-pill <%= customer.active?'':'inactive' %>"><%= customer.active?'Ativo':'Inativo' %></span></p></div><a class="btn btn-primary" href="/customers/<%= customer.id %>/edit">Editar cliente ↗</a></div>
<% if(saved) { %><div class="alert alert-success" role="status">Cliente salvo com sucesso.</div><% } %>
<div class="settings-grid"><section class="settings-card"><h2>Informações do cliente</h2><dl class="customer-data"><% for(const [field,label] of [['name','Nome / razão social'],['trade_name','Nome fantasia'],['document','CPF/CNPJ'],['email','E-mail'],['phone','Telefone / WhatsApp']]) { %><div><dt><%= label %></dt><dd><%= customer[field] || 'Não informado' %></dd></div><% } %></dl><hr><h2>Endereço</h2><dl class="customer-data"><% for(const [field,label] of [['postal_code','CEP'],['street','Logradouro'],['number','Número'],['complement','Complemento'],['neighborhood','Bairro'],['city','Cidade'],['state','UF']]) { %><div><dt><%= label %></dt><dd><%= customer[field] || 'Não informado' %></dd></div><% } %></dl><hr><h2>Observações</h2><p class="customer-notes"><%= customer.notes || 'Nenhuma observação cadastrada.' %></p></section>
<aside class="settings-card"><span class="overline">ORGANIZAÇÃO</span><h2><%= customer.active?'Cliente ativo':'Cliente inativo' %></h2><p class="text-secondary">Inativar preserva os dados do cliente para consulta. Você poderá reativá-lo quando precisar.</p><details class="status-confirm"><summary><%= customer.active?'Inativar cliente':'Reativar cliente' %></summary><form method="post" action="/customers/<%= customer.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="active" value="<%= customer.active?'0':'1' %>"><p>Confirma <%= customer.active?'a inativação':'a reativação' %> deste cliente?</p><button class="btn btn-light" type="submit">Confirmar <%= customer.active?'inativação':'reativação' %></button></form></details><hr><p class="text-secondary small">Cadastrado em <%= new Date(customer.created_at).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'}) %><br>Atualizado em <%= new Date(customer.updated_at).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'}) %></p></aside></div></main></body></html>
