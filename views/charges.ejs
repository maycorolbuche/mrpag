<%- include('header', {title:'Cobranças'}) %>
<div class="page-heading">
  <h1 class="workspace-title">Cobranças</h1>
  <a class="btn btn-light" href="/account/payments">Integrações</a>
</div>
<%- include('recurring-list') %>
<section class="settings-card" id="avulsas" aria-labelledby="one-off-title">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h2 class="h4 mb-0" id="one-off-title">Cobranças Avulsas</h2>
    <a class="btn btn-primary" href="/charges/new">Nova Cobrança Avulsa</a>
  </div>
  <% if (!charges.length) { %>
    <p class="mb-0 text-secondary">Nenhuma cobrança avulsa nesta página.</p>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle">
        <thead><tr><th scope="col">Descrição</th><th scope="col">Cliente</th><th scope="col">Valor</th><th scope="col">Vencimento</th><th scope="col">Situação</th></tr></thead>
        <tbody>
          <% for (const item of charges) { %>
            <tr><td><a href="/charges/<%= item.id %>"><%= item.description %></a></td><td><%= item.customer_name %></td><td><%= item.amount %></td><td><%= item.date %></td><td><%= item.label %></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
  <% if (chargePage > 1 || nextPage) { %>
    <nav class="d-flex gap-2" aria-label="Paginação de cobranças avulsas">
      <% if (chargePage > 1) { %><a class="btn btn-light" href="/charges?page=<%= chargePage - 1 %>&amp;recurringPage=<%= recurringPage %>#avulsas">Anterior</a><% } %>
      <% if (nextPage) { %><a class="btn btn-light" href="/charges?page=<%= chargePage + 1 %>&amp;recurringPage=<%= recurringPage %>#avulsas">Próxima</a><% } %>
    </nav>
  <% } %>
</section>
</main></body></html>
